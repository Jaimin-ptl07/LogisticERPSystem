{
  "theme": {
    "colors": {
      "primary": {
        "50": "#eff6ff",
        "500": "#3b82f6",
        "600": "#2563eb",
        "700": "#1d4ed8"
      },
      "secondary": {
        "50": "#f0fdfa",
        "500": "#14b8a6",
        "600": "#0d9488"
      },
      "gray": {
        "50": "#f9fafb",
        "100": "#f3f4f6",
        "200": "#e5e7eb",
        "300": "#d1d5db",
        "400": "#9ca3af",
        "500": "#6b7280",
        "600": "#4b5563",
        "700": "#374151",
        "800": "#1f2937",
        "900": "#111827"
      },
      "success": "#10b981",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#3b82f6"
    },
    "fontFamily": {
      "sans": ["Inter", "ui-sans-serif", "system-ui"],
      "mono": ["JetBrains Mono", "ui-monospace"]
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem"
    },
    "spacing": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "3rem"
    },
    "shadows": {
      "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1)",
      "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1)"
    },
    "borderRadius": {
      "sm": "0.25rem",
      "md": "0.375rem",
      "lg": "0.5rem",
      "xl": "0.75rem"
    }
  },
  "components": {
    "button": {
      "variants": {
        "primary": {
          "bgColor": "primary.600",
          "textColor": "white",
          "hoverBg": "primary.700",
          "padding": "sm md",
          "borderRadius": "md"
        },
        "secondary": {
          "bgColor": "gray.100",
          "textColor": "gray.700",
          "hoverBg": "gray.200",
          "padding": "sm md",
          "borderRadius": "md"
        },
        "outline": {
          "bgColor": "transparent",
          "textColor": "primary.600",
          "borderColor": "primary.600",
          "hoverBg": "primary.50",
          "padding": "sm md",
          "borderRadius": "md"
        }
      }
    },
    "card": {
      "bgColor": "white",
      "borderColor": "gray.200",
      "borderRadius": "lg",
      "shadow": "md",
      "padding": "lg"
    },
    "sidebar": {
      "bgColor": "gray.900",
      "textColor": "gray.100",
      "width": "16rem",
      "itemHoverBg": "gray.800",
      "activeItemBg": "gray.700"
    },
    "table": {
      "headerBg": "gray.50",
      "borderColor": "gray.200",
      "rowHoverBg": "gray.50",
      "padding": "sm md"
    }
  },
  "layout": {
    "header": {
      "height": "4rem",
      "bgColor": "white",
      "borderColor": "gray.200"
    },
    "content": {
      "padding": "lg",
      "maxWidth": "100%"
    }
  }
}